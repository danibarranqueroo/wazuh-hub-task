# Copy to .env (gitignored) and fill in. Every value can also be set as an environment variable.

# Wazuh server API (port 55000, not the indexer or the dashboard)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
# In the wazuh-docker lab this is API_PASSWORD under wazuh.manager in single-node/docker-compose.yml
# (the wazuh-docker default unless you changed it). Never commit the real value.
WAZUH_API_PASSWORD=change-me
# The wazuh-docker lab uses a self-signed certificate. Set to true in any real deployment.
WAZUH_VERIFY_TLS=false
# Optional tuning
# WAZUH_TIMEOUT_SECONDS=10
# WAZUH_MAX_RETRIES=2

# Which summarizer writes the brief:
#   auto        (default) Claude API if ANTHROPIC_API_KEY is set, else the rule-based mock
#   anthropic   Claude API; the mock if ANTHROPIC_API_KEY is missing
#   claude-code DEV ONLY. Claude Agent SDK on your own Claude Code login, no API key.
#               Needs `uv sync --extra claude-code`. Never used in production (docs/adr/0002).
#   mock        Always the rule-based mock
LLM_PROVIDER=auto

# Claude API. Leave empty to use the deterministic mock summarizer.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT_SECONDS=45   (claude-code uses at least 120)
# LLM_MAX_TOKENS=6000
